    {"id":"setup-receipt","name":"Armazenamento configurado","type":"n8n-nodes-base.code","typeVersion":2,"position":[1200,-260],"parameters":{"jsCode":"const folder = $('Criar pasta de consultas').first().json;\nconst sheet = $('Criar planilha de registro').first().json;\nreturn [{ json: {\n  status: 'configurado',\n  pasta_id: folder.id,\n  pasta_url: `https://drive.google.com/drive/folders/${folder.id}`,\n  planilha_id: sheet.spreadsheetId,\n  planilha_url: sheet.spreadsheetUrl || `https://docs.google.com/spreadsheets/d/${sheet.spreadsheetId}/edit`\n} }];"}},
