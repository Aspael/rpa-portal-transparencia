    {"id":"find-sheet","name":"Localizar planilha","type":"n8n-nodes-base.googleDrive","typeVersion":3,"position":[720,220],"alwaysOutputData":true,"parameters":{"resource":"fileFolder","operation":"search","searchMethod":"query","queryString":"name = 'RPA Portal da Transparência — Registro' and mimeType = 'application/vnd.google-apps.spreadsheet' and trashed = false","returnAll":false,"limit":1,"filter":{},"options":{"fields":["id","name","mimeType","webViewLink"]}}},
    {"id":"validate-storage","name":"Validar armazenamento","type":"n8n-nodes-base.code","typeVersion":2,"position":[960,220],"parameters":{"jsCode":"const folder = $('Localizar pasta').first().json;\nconst sheet = $('Localizar planilha').first().json;\nif (!folder.id || !sheet.id) {\n  throw new Error('Armazenamento não encontrado. Execute primeiro o gatilho 1. Configurar armazenamento.');\n}\nreturn [{ json: $('Entrada').first().json }];"}},
    {"id":"robot","name":"Consultar RPA","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1200,220],"parameters":{"method":"POST","url":"={{ $json.api_url }}/consultas","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendBody":true,"specifyBody":"json","jsonBody":"={{ { termo: $json.termo, beneficiario_programa_social: $json.beneficiario_programa_social } }}","options":{"timeout":180000,"redirect":{"redirect":{"followRedirects":false}},"response":{"response":{"neverError":true,"responseFormat":"json"}}}}},
    {"id":"validate","name":"Validar resultado","type":"n8n-nodes-base.code","typeVersion":2,"position":[1440,220],"parameters":{"jsCode":"const result = $input.first().json;\nif (!result.consulta_id || !result.consultado_em || !['sucesso', 'parcial', 'erro'].includes(result.status)) {\n  throw new Error('A API não devolveu uma consulta válida. Confira URL, autenticação e entrada.');\n}\nreturn [{ json: result }];"}},
    {"id":"binary","name":"Preparar arquivo JSON","type":"n8n-nodes-base.code","typeVersion":2,"position":[1680,220],"parameters":{"jsCode":"const result = $input.first().json;\nconst stamp = result.consultado_em.replace(/[-:.]/g, '').replace('+00:00', 'Z');\nconst fileName = `${result.consulta_id}_${stamp}.json`;\nconst data = Buffer.from(JSON.stringify(result, null, 2), 'utf8').toString('base64');\nreturn [{ json: { consulta_id: result.consulta_id }, binary: { data: { data, mimeType: 'application/json', fileName, fileExtension: 'json' } } }];"}},
    {"id":"drive","name":"Salvar JSON no Drive","type":"n8n-nodes-base.googleDrive","typeVersion":3,"position":[1920,220],"parameters":{"resource":"file","operation":"upload","inputDataFieldName":"data","name":"={{ $binary.data.fileName }}","driveId":{"__rl":true,"mode":"list","value":"My Drive","cachedResultName":"My Drive"},"folderId":{"__rl":true,"mode":"id","value":"={{ $('Localizar pasta').first().json.id }}"},"options":{"simplifyOutput":true}}},
    {"id":"row","name":"Preparar registro","type":"n8n-nodes-base.code","typeVersion":2,"position":[2160,220],"parameters":{"jsCode":"const result = $('Validar resultado').first().json;\nconst file = $input.first().json;\nreturn [{ json: {\n  consulta_id: result.consulta_id,\n  nome: result.pessoa?.nome || '',\n  cpf: result.pessoa?.cpf || '',\n  consultado_em: result.consultado_em,\n  arquivo_json: `https://drive.google.com/file/d/${file.id}/view`,\n  status: result.status,\n  codigo: result.codigo || ''\n} }];"}},
