    {"id":"receipt","name":"Recibo da execução","type":"n8n-nodes-base.code","typeVersion":2,"position":[2640,220],"parameters":{"jsCode":"const result = $('Validar resultado').first().json;\nconst file = $('Salvar JSON no Drive').first().json;\nconst sheet = $('Localizar planilha').first().json;\nreturn [{ json: {\n  consulta_id: result.consulta_id,\n  status_coleta: result.status,\n  codigo_coleta: result.codigo || null,\n  status_arquivamento: 'concluido',\n  arquivo_id: file.id,\n  arquivo_nome: file.name,\n  arquivo_url: `https://drive.google.com/file/d/${file.id}/view`,\n  planilha_url: `https://docs.google.com/spreadsheets/d/${sheet.id}/edit`\n} }];"}}
