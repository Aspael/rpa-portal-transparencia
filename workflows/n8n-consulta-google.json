    {"id":"input","name":"Entrada","type":"n8n-nodes-base.code","typeVersion":2,"position":[240,220],"parameters":{"jsCode":"const payload = $input.first().json || {};\nconst body = payload.body || payload;\nreturn [{ json: {\n  api_url: (typeof $env !== 'undefined' && $env.RPA_API_URL) || 'https://python-rpa-9f3d.72-60-12-215.sslip.io',\n  termo: body.termo || 'TESTE INEXISTENTE MOSTQI XYZ',\n  beneficiario_programa_social: body.beneficiario_programa_social === true\n} }];"}},
