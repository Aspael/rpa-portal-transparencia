HEADLESS=true
MAX_CONCURRENT=3
QUERY_TIMEOUT_SECONDS=120
NAVIGATION_TIMEOUT_MS=30000
MAX_DETAIL_PAGES=100
# X-API-Key: protege a SUA API (localhost:8000). É o valor do campo
# "Chave de acesso da API" no front e do header X-API-Key no n8n/curl.
# Não é enviada ao Portal da Transparência e não evita o CAPTCHA.
# Defina antes de expor a API fora de localhost.
API_KEY=
REQUIRE_API_KEY=false
# true: o front (http://localhost:8000) usa o API_KEY acima sozinho; o campo
# "Chave de acesso da API" fica opcional e, se preenchido, tem prioridade.
# Use false se a página for acessível a outras pessoas (VPS, Render...).
FRONT_API_KEY_FROM_ENV=true

# Chave da API de Dados do Portal da Transparência (consultas ao governo).
# Cadastro gratuito com conta gov.br: https://portaldatransparencia.gov.br/api-de-dados
# A chave chega por e-mail e vai no header "chave-api-dados" das requisições.
#
# Por que usar: o site do portal é protegido pelo AWS WAF, que bloqueia o
# navegador automatizado com desafio antirrobô/CAPTCHA (erro PORTAL_BLOQUEADO,
# HTTP 502). A API de Dados é o canal oficial para acesso automatizado:
# responde JSON, não exige CAPTCHA e não depende de IP, rede ou navegador.
# Limitação: consulta por CPF/NIS, não por nome.
#
# Limites da API de Dados, por chave (confira a página oficial, podem mudar):
#   - 06:00 às 23:59: 90 requisições por minuto
#   - 00:00 às 05:59: 300 requisições por minuto
# Uma consulta de pessoa faz uma requisição por benefício (Bolsa Família,
# BPC, Auxílio Emergencial...), então ela usa várias requisições do limite.
#
# Se passar do limite, o portal responde HTTP 429 (Too Many Requests):
#   1. pare de enviar e aguarde o próximo minuto antes de repetir;
#   2. repita com espera crescente (ex.: 5 s, 15 s, 60 s), sem laço imediato;
#   3. reduza o ritmo com PORTAL_API_MAX_RPM e evite consultas em paralelo;
#   4. deixe cargas grandes para a madrugada (00:00-05:59), quando o limite é maior;
#   5. excessos repetidos podem suspender a chave; nesse caso, peça a
#      reativação pelo Fala.BR (https://falabr.cgu.gov.br).
# Não crie várias chaves para somar limites: isso viola os termos de uso.
# Não versione nem compartilhe o valor da chave.
PORTAL_API_KEY=
# Teto de requisições por minuto do lado do projeto, abaixo do limite oficial
# para deixar margem a outras chamadas com a mesma chave.
PORTAL_API_MAX_RPM=80
# De onde vêm as consultas do botão "Consultar":
#   dados_abertos: (padrão) base local no PostgreSQL com os arquivos de dados
#         abertos do portal. Não acessa o governo na consulta: sem CAPTCHA,
#         sem chave. Importe antes, ex.:
#         docker compose exec api python -m app.importar_dados novo-bolsa-familia 202501 --uf AM
#         Busca por nome completo ou NIS (o CPF vem mascarado nos arquivos).
#   auto:CPF/NIS pela API oficial (se PORTAL_API_KEY existir); nome pelo site.
#   api:  nunca abre o site, então nunca há CAPTCHA. Só CPF/NIS; nome ou
#         PORTAL_API_KEY vazia devolvem erro explicando o motivo.
#   site: sempre o robô no site (sujeito ao CAPTCHA).
QUERY_SOURCE=dados_abertos
# Pasta dos ZIPs baixados pelo importador (no Docker: /app/outputs/dados-abertos).
DADOS_ABERTOS_DIR=outputs/dados-abertos
# Modo assistido: quando o portal pede verificação humana (CAPTCHA), a consulta
# é refeita num Chromium VISÍVEL; você resolve a verificação na janela e o robô
# continua sozinho. Não resolve CAPTCHA automaticamente. Precisa de tela:
#   WSL/Docker: docker compose -f compose.yaml -f compose.assisted.yaml up -d
#   Python local: python run.py --local (com ASSISTED_MODE=true)
ASSISTED_MODE=false
# Segundos que o robô espera você concluir a verificação na janela.
ASSISTED_WAIT_SECONDS=180
# Para a instalação local descrita no README:
PLAYWRIGHT_BROWSERS_PATH=.browsers

# Bônus Google: gere com python -m app.google_setup
GOOGLE_TOKEN_FILE=secrets/google-token.json
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SPREADSHEET_ID=
GOOGLE_SHEET_TAB=Consultas
EXPORT_STATE_DIR=outputs/export-state
# Em hospedagem, configure GOOGLE_TOKEN_JSON como segredo com o conteúdo
# de google-token.json; não versionar nem compartilhar o valor.

# Histórico das consultas (PostgreSQL). Vazio desativa a gravação.
# No docker compose a API usa o serviço "postgres" automaticamente, e
# python run.py --local aponta para ele em localhost. Preencha só para usar
# outro banco, ex.: postgresql://observa:observa@localhost:5432/observa
DATABASE_URL=
POSTGRES_USER=observa
POSTGRES_PASSWORD=observa
POSTGRES_DB=observa
POSTGRES_HOST_PORT=5432
# Horas em que um resultado com sucesso do histórico é reaproveitado numa nova
# consulta pelo mesmo termo, sem ir ao portal. 0 desativa; "atualizar": true
# no corpo de POST /consultas força nova consulta.
HISTORY_CACHE_HOURS=24

# pgAdmin (contêiner): http://localhost:5050, já com o servidor "observa".
PGADMIN_VERSION=9.19
PGADMIN_HOST_PORT=5050
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=observa

# Docker Compose
HOST_PORT=8000
DOCKER_NETWORK=rpa-network

# n8n (contêiner)
N8N_VERSION=stable
N8N_HOST_PORT=5678
N8N_WEBHOOK_URL=http://localhost:5678/
# Gere uma chave fixa (ex.: openssl rand -hex 32) para não perder as credenciais salvas.
N8N_ENCRYPTION_KEY=
TZ=America/Manaus
