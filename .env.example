HEADLESS=true
MAX_CONCURRENT=3
QUERY_TIMEOUT_SECONDS=120
NAVIGATION_TIMEOUT_MS=30000
MAX_DETAIL_PAGES=100
# Defina antes de expor a API fora de localhost.
API_KEY=
REQUIRE_API_KEY=false
# Para a instalação local descrita no README:
PLAYWRIGHT_BROWSERS_PATH=.browsers

# Bônus Google: gere com python -m app.google_setup
GOOGLE_TOKEN_FILE=secrets/google-token.json
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SPREADSHEET_ID=
GOOGLE_SHEET_TAB=Consultas
EXPORT_STATE_DIR=outputs/export-state
# Em hospedagem, configure GOOGLE_TOKEN_JSON como segredo com o conteúdo
# de google-token.json; não versionar nem compartilhar o valor.

# Docker Compose
HOST_PORT=8000
DOCKER_NETWORK=rpa-network

# n8n (contêiner)
N8N_VERSION=stable
N8N_HOST_PORT=5678
N8N_WEBHOOK_URL=http://localhost:5678/
# Gere uma chave fixa (ex.: openssl rand -hex 32) para não perder as credenciais salvas.
N8N_ENCRYPTION_KEY=
TZ=America/Manaus
